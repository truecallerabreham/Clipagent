CLIPAGENT_API_KEY=
CLIPAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLIPAGENT_MODEL_NAME=qwen-plus

# Leave the dedicated video/TTS key or base URL empty to inherit the main API settings.
CLIPAGENT_VIDEO_API_KEY=
CLIPAGENT_VIDEO_BASE_URL=
CLIPAGENT_VIDEO_MODEL_NAME=qwen-vl-max-latest

CLIPAGENT_TTS_API_KEY=
CLIPAGENT_TTS_BASE_URL=
CLIPAGENT_TTS_MODEL_NAME=qwen-tts-latest

CLIPAGENT_ENABLE_PHASE2_RESEARCH=true
CLIPAGENT_ENABLE_PLAN_REVIEW=true
CLIPAGENT_DIRECT_PHASE3_EXECUTION=false
CLIPAGENT_PREFER_LOCAL_MATERIALS=false
CLIPAGENT_SEARCH_POOL_SIZE=4
CLIPAGENT_DOWNLOAD_POOL_SIZE=2
CLIPAGENT_VIDEO_ANALYSIS_POOL_SIZE=2
CLIPAGENT_LLM_POOL_SIZE=2
CLIPAGENT_FFMPEG_POOL_SIZE=2
CLIPAGENT_TTS_POOL_SIZE=2
CLIPAGENT_EXPORT_POOL_SIZE=1
CLIPAGENT_SHORT_FORM_OPTIMIZATIONS=true
CLIPAGENT_SHORT_FORM_MAX_SOURCES=2
CLIPAGENT_VIDEO_ANALYSIS_PROXY_MAX_SECONDS=45
CLIPAGENT_DOWNLOAD_MAX_HEIGHT=720
CLIPAGENT_STANDARDIZE_TARGET_FPS=30
CLIPAGENT_AUDIO_LOUDNORM_TARGET=0
CLIPAGENT_YOUTUBE_MODE=auto
CLIPAGENT_ENABLED_MATERIAL_PLATFORMS=bilibili,douyin,xiaohongshu,youtube
CLIPAGENT_DEFAULT_DEADLINE_SECONDS=600
CLIPAGENT_PROCESSING_MODE=auto
CLIPAGENT_PHASE1_MAX_SECONDS=180
CLIPAGENT_OUTPUT_PROFILE=auto
CLIPAGENT_BROWSER_AUTH_BROWSER=
CLIPAGENT_BROWSER_AUTH_PROFILE=
CLIPAGENT_POST_TASK_REVIEW_MODE=async
CLIPAGENT_AGENT_STALL_TIMEOUT_SECONDS=600
