{
  "id": "architecture-flow",
  "name": "Architecture Flow",
  "description": "Dark-mode system architecture and packet-flow explainer: charcoal service cards, thin gray links, glowing packet streams and color-coded token pills that travel between client, servers and data stores.",
  "best_for": [
    "system design",
    "backend architecture",
    "authentication and tokens (JWT, sessions, OAuth)",
    "API request flows",
    "caching and databases",
    "latency, bottlenecks and scaling",
    "security attacks (replay, MITM, token theft)",
    "microservices and queues"
  ],
  "dark": true,
  "accent": "#38BDF8",
  "canvas": { "background": "#000000" },
  "palette": {
    "background": "#000000",
    "card": "#161618",
    "card_border": "#2A2A2E",
    "card_inner": "#1E1E21",
    "divider": "#242428",
    "link": "#4B5563",
    "text": "#F4F4F5",
    "text_dim": "#A1A1AA",
    "text_faint": "#71717A"
  },
  "tokens": {
    "alert": "#F43F5E",
    "ok": "#22C55E",
    "link": "#4B5563",
    "packet": "#E0F2FE",
    "white": "#FFFFFF",
    "warn": "#F59E0B"
  },
  "fonts": {
    "marker": { "family": "Caveat Brush", "file": "assets/fonts/caveat-brush-latin-400-normal.woff2", "license": "OFL-1.1" },
    "sans": { "family": "Inter", "files": "assets/fonts/inter-latin-*-normal.woff2", "license": "OFL-1.1" },
    "mono": { "family": "JetBrains Mono", "files": "assets/fonts/jetbrains-mono-latin-*-normal.woff2", "license": "OFL-1.1" }
  },
  "concept_palette": ["#38BDF8", "#F59E0B", "#A855F7", "#22C55E", "#F472B6", "#FACC15", "#2DD4BF", "#FB7185"],
  "semantic": {
    "session id": "#F59E0B",
    "session": "#F59E0B",
    "session cookie": "#F59E0B",
    "sid": "#F59E0B",
    "jwt": "#38BDF8",
    "access token": "#38BDF8",
    "access": "#38BDF8",
    "bearer token": "#38BDF8",
    "refresh token": "#A855F7",
    "refresh": "#A855F7"
  },
  "screen_treatment": {
    "background": ["#0B0B0D", "#111827"],
    "frame": "plain",
    "radius": 12,
    "inset": 0.05,
    "zoom_scale": [1.2, 1.5],
    "click_effect": "glow",
    "annotation_color": "#38BDF8",
    "transition": "crossfade",
    "transition_colors": ["#38BDF8", "#A855F7", "#F59E0B"],
    "shortcut_badge": { "bg": "#161618", "fg": "#FFFFFF" }
  },
  "captions": { "enabled": true, "color": "#FFFFFF", "highlight": "#38BDF8", "words_per_line": 4 },
  "chapter_card": { "bg": "#000000", "fg": "#FFFFFF", "tracking": 0.3, "duration": 2.0 },
  "sfx": {
    "transition": "swoosh",
    "click": "tick",
    "chapter": "marker",
    "SectionTitle.enter": "marker",
    "HookQuestion.reveal": "type",
    "ServiceCard.enter": "pop",
    "Database.enter": "pop",
    "Device.enter": "pop",
    "Device.tap": "tick",
    "TokenPill.send": "whoosh",
    "TokenPill.show": "pop",
    "TokenPill.expire": "tick",
    "Database.lookup": "tick",
    "Database.validate": "ding",
    "ServiceCard.validate": "ding",
    "validate.match": "ding",
    "validate.mismatch": "alert",
    "ServiceCard.latency": "alert",
    "ServiceCard.alert": "alert",
    "Hacker.enter": "alert",
    "Hacker.intercept": "swoosh",
    "Hacker.replay": "whoosh",
    "Callout.enter": "pop",
    "Metric.set": "tick"
  },
  "music": "dark-pulse",
  "layout": "architecture-flow",
  "design_short_side": 960,
  "design_short_side_portrait": 880,
  "scene_shortcuts": { "title": "SectionTitle", "hook": "HookQuestion" },
  "runtime": {
    "scripts": ["assets/icons/lucide-subset.js"],
    "preload_fonts": [
      "400 40px 'Caveat Brush'",
      "400 20px 'Inter'", "500 20px 'Inter'", "600 20px 'Inter'", "700 20px 'Inter'", "800 20px 'Inter'",
      "400 20px 'JetBrains Mono'", "500 20px 'JetBrains Mono'", "700 20px 'JetBrains Mono'"
    ]
  }
}
