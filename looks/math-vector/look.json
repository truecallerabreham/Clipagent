{
  "id": "math-vector",
  "name": "Math Vector",
  "description": "3Blue1Brown-style programmatic math animation: pure black canvas, muted cyan coordinate grid, LaTeX (Computer Modern) equations written on stroke by stroke, vectors that grow from the origin, curly braces, dashed projections and live number counters, with every idea morphing into the next.",
  "best_for": [
    "linear algebra (vectors, matrices, transformations)",
    "calculus and function graphs",
    "optimization and gradient descent",
    "equations and derivations",
    "geometry and trigonometry",
    "physics and signal intuition",
    "machine learning math",
    "any explanation with a formula in it"
  ],
