{
  "id": "neon-telestrator",
  "name": "Neon Telestrator",
  "description": "Dark-mode technical telestrator: pure black canvas, pressure-sensitive neon ink drawn on stroke by stroke (no hand), handwritten labels, sketched icons and charts, live telestration over screenshots, a glowing three.js 3D data module and bold red pointer callouts.",
  "best_for": [
    "AI / ML explainers (models, GPUs, inference, training)",
    "benchmark and leaderboard breakdowns",
    "pricing, cost and performance comparisons",
    "reacting to news charts and screenshots",
    "multi-variable trade-offs (3D charts)",
    "whiteboard-style technical reasoning on a dark canvas",
    "code walk-throughs with handwritten highlights"
  ],
  "dark": true,
  "accent": "#D946EF",
  "canvas": { "background": "#000000" },
  "palette": {
    "background": "#000000",
    "ink": "#FFFFFF",
    "panel": "#0A0A0B",
    "panel_border": "#262626",
    "grid": "#222222",
    "text_dim": "#A1A1AA",
    "text_faint": "#71717A"
  },
  "tokens": {
    "white": "#FFFFFF",
    "ink": "#FFFFFF",
    "green": "#2ECC71",
    "gain": "#2ECC71",
    "ok": "#2ECC71",
    "money": "#2ECC71",
    "red": "#FF2A2A",
    "alert": "#FF2A2A",
    "loss": "#FF2A2A",
    "purple": "#D946EF",
    "pink": "#D946EF",
    "cyan": "#3B82F6",
    "blue": "#3B82F6",
    "yellow": "#FACC15",
    "category": "#FACC15",
    "grid": "#222222",
    "dim": "#A1A1AA"
  },
  "ink_rules": {
    "base diagrams and text": "#FFFFFF",
    "positive metrics, price drops, money flows": "#2ECC71",
    "price cross-outs, inefficiency hatch zones, attention pointers": "#FF2A2A",
    "grouping loops, brackets, trade-offs (side A)": "#D946EF",
    "trade-offs (side B)": "#3B82F6",
    "category brackets, cross-panel connectors": "#FACC15"
  },
  "fonts": {
    "hand": { "family": "Kalam", "files": "assets/fonts/kalam-latin-{400,700}-normal.woff2", "license": "OFL-1.1" },
    "script": { "family": "Caveat", "files": "assets/fonts/caveat-latin-{500,700}-normal.woff2", "license": "OFL-1.1" },
    "sans": { "family": "Inter", "files": "assets/fonts/inter-latin-*-normal.woff2", "license": "OFL-1.1" },
    "mono": { "family": "JetBrains Mono", "files": "assets/fonts/jetbrains-mono-latin-*-normal.woff2", "license": "OFL-1.1" }
  },
  "concept_palette": ["#D946EF", "#3B82F6", "#FACC15", "#2ECC71", "#F472B6", "#22D3EE", "#FB923C", "#A78BFA"],
  "semantic": {
    "cost": "#2ECC71",
    "price": "#2ECC71",
    "savings": "#2ECC71",
    "profit": "#2ECC71",
    "revenue": "#2ECC71",
    "waste": "#FF2A2A",
    "bottleneck": "#FF2A2A",
    "inefficiency": "#FF2A2A"
  },
  "screen_treatment": {
    "background": ["#000000", "#0A0A0F"],
    "frame": "plain",
    "radius": 12,
    "inset": 0.05,
    "zoom_scale": [1.25, 1.6],
    "click_effect": "red_arrow",
    "annotation_color": "#FF2A2A",
    "transition": "crossfade",
    "transition_colors": ["#D946EF", "#3B82F6", "#FACC15"],
    "shortcut_badge": { "bg": "#0A0A0B", "fg": "#FFFFFF" }
  },
  "captions": { "enabled": true, "color": "#FFFFFF", "highlight": "#D946EF", "words_per_line": 4 },
  "chapter_card": { "bg": "#000000", "fg": "#FFFFFF", "tracking": 0.3, "duration": 2.0 },
  "sfx": {
    "transition": "swoosh",
    "click": "tick",
    "chapter": "marker",
    "Title.enter": "marker",
    "InkText.enter": "marker",
    "InkText.write": "marker",
    "InkStroke.draw": "marker",
    "Icon.draw": "marker",
    "Loop.draw": "marker",
    "Underline.draw": "marker",
    "Bracket.draw": "marker",
    "Arrow.draw": "marker",
    "CrossOut.draw": "marker",
    "HatchZone.draw": "marker",
    "Screenshot.enter": "swoosh",
    "Screenshot.spotlight": "soft",
    "BarChart.draw": "marker",
    "BarChart.set": "tick",
    "LineChart.draw": "marker",
    "Chart3D.enter": "swoosh",
    "Chart3D.orbit": "whoosh",
    "Chart3D.view": "whoosh",
    "RedPointer.point": "pop",
    "Metric.set": "tick",
    "Metric.strike": "marker",
    "CodeSnippet.enter": "type",
    "CodeSnippet.mark": "marker"
  },
  "music": "dark-pulse",
  "layout": "neon-telestrator",
  "design_short_side": 1080,
  "design_short_side_portrait": 1080,
  "scene_shortcuts": { "title": "Title" },
  "runtime": {
    "scripts": ["assets/vendor/three/three.min.js", "assets/icons/sketch-icons.js"],
    "preload_fonts": [
      "400 40px 'Kalam'", "700 40px 'Kalam'",
      "500 40px 'Caveat'", "700 40px 'Caveat'",
      "400 20px 'Inter'", "600 20px 'Inter'", "700 20px 'Inter'",
      "400 20px 'JetBrains Mono'", "700 20px 'JetBrains Mono'"
    ]
  }
}
