{
  "id": "whiteboard-saas",
  "name": "Whiteboard SaaS",
  "description": "Whiteboard sketch and annotated SaaS explainer: a cutout hand draws line-art illustrations, diagrams and handwritten notes on a pure white board, then colors them in with an angled wipe; bold kinetic takeaways with an electric-purple keyword, black chapter cards, and marching-ants boxes, dashed arrows, chevrons, pill badges and pointer hands over the product UI.",
  "best_for": [
    "SaaS product walkthroughs and demos",
    "pricing, plans and onboarding explainers",
    "startup pitches and business ideas",
    "marketing and growth concepts",
    "feature launches and how-it-works overviews",
    "simple process flows and checklists",
    "non-technical audiences"
  ],
  "dark": false,
  "accent": "#5E17EB",
  "canvas": { "background": "#FFFFFF" },
  "palette": {
    "background": "#FFFFFF",
    "ink": "#111111",
    "ink_soft": "#3F3F46",
    "muted": "#6B7280",
    "line": "#D4D4D8",
    "accent": "#5E17EB",
    "accent_tint": "#E9DEFF",
    "pill": "#1E1E1E",
    "pill_text": "#FFFFFF",
    "card": "#FFFFFF"
  },
  "tokens": {
    "accent": "#5E17EB",
    "purple": "#5E17EB",
    "ink": "#111111",
    "black": "#111111",
    "red": "#EF4444",
    "alert": "#EF4444",
    "green": "#16A34A",
    "ok": "#16A34A",
    "yellow": "#FACC15",
    "blue": "#3B82F6",
    "orange": "#F97316",
    "gray": "#9CA3AF",
    "white": "#FFFFFF",
    "dark": "#1E1E1E"
  },
  "fonts": {
    "hand": { "family": "Caveat", "files": "assets/fonts/caveat-latin-*-normal.woff2", "license": "OFL-1.1" },
    "sans": { "family": "Poppins", "files": "assets/fonts/poppins-latin-*-normal.woff2", "license": "OFL-1.1" }
  },
  "concept_palette": ["#5E17EB", "#F97316", "#16A34A", "#3B82F6", "#EC4899", "#EAB308", "#0D9488", "#EF4444"],
  "semantic": {},
  "screen_treatment": {
    "background": ["#F4F4F6", "#E5E7EB"],
    "frame": "plain",
    "radius": 16,
    "inset": 0.05,
    "zoom_scale": [1.2, 1.6],
    "click_effect": "pointer_hand",
    "annotation_color": "#5E17EB",
    "transition": "diagonal_wipe",
    "transition_colors": ["#5E17EB", "#111111", "#FACC15"],
    "shortcut_badge": { "bg": "#1E1E1E", "fg": "#FFFFFF" }
  },
  "captions": { "enabled": true, "color": "#111111", "highlight": "#5E17EB", "background": "#FFFFFF", "words_per_line": 4 },
  "chapter_card": { "enabled": true, "bg": "#000000", "fg": "#FFFFFF", "tracking": 0.3, "duration": 2.0, "scale": [1.0, 1.08] },
  "sfx": {
    "transition": "swoosh",
    "click": "tick",
    "chapter": "whoosh",
    "shortcut": "tick",
    "overlay": "pop",
    "draw": "marker",
    "write": "marker",
    "place": "swoosh",
    "take": "swoosh",
    "check": "ding",
    "checkAll": "ding",
    "step": "marker",
    "fill": "marker",
    "reveal": "pop",
    "emphasize": "pop",
    "tap": "tick",
    "select": "pop",
    "HandDraw.draw": "marker",
    "Icon.draw": "marker",
    "SketchText.write": "marker",
    "SketchText.underline": "marker",
    "SketchText.circle": "marker",
    "HandPlace.place": "swoosh",
    "KineticText.reveal": "pop",
    "ChapterCard.enter": "whoosh",
    "Arrow.enter": "marker",
    "Chevrons.enter": "pop",
    "MarchingBox.enter": "marker",
    "PillLabel.enter": "pop",
    "PointerHand.enter": "whoosh",
    "PointerHand.click": "tick",
    "UIMock.enter": "marker",
    "UIMock.click": "tick",
    "Checklist.check": "ding",
    "Diagram.draw": "marker"
  },
  "music": "bright-pluck",
  "layout": "whiteboard-saas",
  "design_short_side": 1080,
  "design_short_side_portrait": 1080,
  "scene_shortcuts": { "title": "SketchText" },
  "runtime": {
    "scripts": ["assets/hands/hands.js", "assets/art/art.js"],
    "preload_fonts": [
      "500 40px 'Caveat'", "600 40px 'Caveat'", "700 40px 'Caveat'",
      "400 20px 'Poppins'", "500 20px 'Poppins'", "600 20px 'Poppins'", "700 20px 'Poppins'", "800 20px 'Poppins'"
    ]
  }
}
